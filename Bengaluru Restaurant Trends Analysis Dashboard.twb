      <column caption='Cleaned_ratings' datatype='real' name='[Calculation_1547830962732232704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([rate]) &#13;&#10;   OR [rate] = &apos;&quot;NEW&quot;&apos; &#13;&#10;   OR [rate] = &apos;&quot;-&quot;&apos; &#13;&#10;   OR [rate] = &apos;&quot;NaN&quot;&apos; THEN &#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    ROUND(&#13;&#10;        FLOAT(LEFT(REPLACE([rate], &apos;&quot;&apos;, &apos;&apos;), FIND(REPLACE([rate], &apos;&quot;&apos;, &apos;&apos;), &apos;/&apos;) - 1)),&#13;&#10;        1&#13;&#10;    )&#13;&#10;END' />
