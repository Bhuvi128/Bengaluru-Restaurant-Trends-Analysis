    <worksheet name='Average rating'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#b07aa1' fontsize='9'>Average rating</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='restaurant+' name='federated.04gyhgy0s8mw001gdojwc1lcj79r' />
          </datasources>
          <datasource-dependencies datasource='federated.04gyhgy0s8mw001gdojwc1lcj79r'>
            <column caption='Cleaned_ratings' datatype='real' name='[Calculation_1547830962732232704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ISNULL([rate]) &#13;&#10;   OR [rate] = &apos;&quot;NEW&quot;&apos; &#13;&#10;   OR [rate] = &apos;&quot;-&quot;&apos; &#13;&#10;   OR [rate] = &apos;&quot;NaN&quot;&apos; THEN &#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    ROUND(&#13;&#10;        FLOAT(LEFT(REPLACE([rate], &apos;&quot;&apos;, &apos;&apos;), FIND(REPLACE([rate], &apos;&quot;&apos;, &apos;&apos;), &apos;/&apos;) - 1)),&#13;&#10;        1&#13;&#10;    )&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1547830962732232704]' derivation='Avg' name='[avg:Calculation_1547830962732232704:qk]' pivot='key' type='quantitative' />
            <column caption='Rate' datatype='string' name='[rate]' role='dimension' type='nominal' />
